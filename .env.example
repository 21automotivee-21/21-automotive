# Copy this file to ".env.local" (same folder) and fill in your real values.
# Next.js loads .env.local automatically; it is gitignored — never commit it.

# Required for the AI chat assistant (/api/chat). Get a key at console.anthropic.com.
# Without it, the chat endpoint responds with a clear 503.
ANTHROPIC_API_KEY=

# Optional — overrides the default chat model (claude-haiku-4-5-20251001).
# CHAT_MODEL=claude-haiku-4-5-20251001

# Optional — shared secret for the admin list endpoints:
#   GET /api/bookings and GET /api/finance-applications (header: x-admin-key)
# Defaults to "dev-admin-key". Set a real value before deploying.
# ADMIN_KEY=

# Optional — path to the SQLite file. Defaults to ./data/data.sqlite
# DATABASE_PATH=

# Optional — your public origin, used to resolve Open Graph image URLs.
# NEXT_PUBLIC_SITE_URL=https://example.com
