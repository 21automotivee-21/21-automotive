# Copy this file to ".env" (same folder) and fill in your real key there.
# server/.env is read by index.js on startup and is for your machine only —
# never commit it or share it.

ANTHROPIC_API_KEY=

# Optional — overrides the default chat model (claude-haiku-4-5-20251001).
# CHAT_MODEL=claude-haiku-4-5-20251001
